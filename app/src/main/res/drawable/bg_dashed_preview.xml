<?xml version="1.0" encoding="utf-8"?>
<!-- Share preview on the Summary screen -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_deep" />
    <corners android:radius="@dimen/radius_share_preview" />
    <stroke
        android:width="@dimen/stroke_thin"
        android:color="@color/dash"
        android:dashWidth="@dimen/dash_width"
        android:dashGap="@dimen/dash_gap" />
</shape>
