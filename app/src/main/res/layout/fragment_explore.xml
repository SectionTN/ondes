<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_h"
            android:paddingTop="@dimen/screen_padding_top_tab">

            <TextView
                android:id="@+id/explore_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_explore"
                android:textAppearance="@style/TextAppearance.Ondes.Headline.Tab" />

            <!-- Teleport card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section_tab">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <FrameLayout
                        android:layout_width="@dimen/teleport_ring_size"
                        android:layout_height="@dimen/teleport_ring_size"
                        android:background="@drawable/bg_dashed_ring"
                        android:importantForAccessibility="noHideDescendants">

                        <ImageView
                            android:layout_width="@dimen/teleport_circle_size"
                            android:layout_height="@dimen/teleport_circle_size"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_accent_soft"
                            android:padding="@dimen/teleport_icon_padding"
                            android:src="@drawable/ic_vibrate"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_tile_inner"
                        android:text="@string/teleport_title"
                        android:textAppearance="@style/TextAppearance.Ondes.Title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/teleport_button"
                        style="@style/Widget.Ondes.Button.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_tile_inner"
                        android:text="@string/action_teleport"
                        app:icon="@drawable/ic_shuffle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Genre chips, scrolling out to the screen edges -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_h_negative"
                android:layout_marginTop="@dimen/gap_section_tab_chips"
                android:layout_marginBottom="@dimen/chip_touch_outset"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_padding_h"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/genre_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/gap_chip"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/genre_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/genre_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/genre_news"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/genre_news" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/genre_music"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/genre_music" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/genre_jazz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/genre_jazz" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/genre_talk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/genre_talk" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/genre_sports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/genre_sports" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Saved stations, shown once the user has favorites -->
            <TextView
                android:id="@+id/saved_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section_tab"
                android:text="@string/section_saved"
                android:textAppearance="@style/TextAppearance.Ondes.Caption.Section"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/saved_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/recent_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section_tab"
                android:text="@string/section_recent"
                android:textAppearance="@style/TextAppearance.Ondes.Caption.Section" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/recent_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/station_row_min_height"
                android:text="@string/recent_empty"
                android:textAppearance="@style/TextAppearance.Ondes.Caption"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Mini player, docked above the bottom navigation -->
    <LinearLayout
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/mini_player_margin"
        android:background="@drawable/bg_mini_player"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/mini_player_padding_start"
        android:paddingTop="@dimen/mini_player_padding"
        android:paddingEnd="@dimen/mini_player_padding"
        android:paddingBottom="@dimen/mini_player_padding">

        <me.sectiontn.ondes.ui.common.EqualizerView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mini_player_equalizer_height"
            app:barCount="3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_row"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_player_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Ondes.Label" />

            <TextView
                android:id="@+id/mini_player_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_text_lines"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Ondes.Caption.Small" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mini_player_button"
            style="@style/Widget.Ondes.IconButton.Accent"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/gap_row"
            android:layout_marginTop="@dimen/icon_button_outset"
            android:layout_marginEnd="@dimen/icon_button_outset"
            android:layout_marginBottom="@dimen/icon_button_outset"
            app:icon="@drawable/ic_pause" />
    </LinearLayout>
</LinearLayout>
