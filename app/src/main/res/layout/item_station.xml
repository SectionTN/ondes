<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_list"
    android:gravity="center_vertical"
    android:minHeight="@dimen/station_row_min_height"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/station_code"
        android:layout_width="@dimen/code_badge_size"
        android:layout_height="@dimen/code_badge_size"
        android:background="@drawable/bg_circle_surface_2"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Ondes.Mono.Code" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_row"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/station_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Ondes.Body.Medium" />

        <TextView
            android:id="@+id/station_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_text_lines"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Ondes.Caption" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/station_heart"
        style="@style/Widget.Ondes.IconButton.Plain"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_marginStart="@dimen/gap_row"
        android:layout_marginEnd="@dimen/icon_button_outset"
        app:icon="@drawable/ic_heart" />
</LinearLayout>
