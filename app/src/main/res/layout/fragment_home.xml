<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_h"
    android:paddingTop="@dimen/screen_padding_top_tab">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Ondes.Wordmark" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/play_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_section_home"
        android:text="@string/action_play"
        app:icon="@drawable/ic_play" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/free_play_button"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_answer"
        android:text="@string/free_play"
        app:icon="@drawable/ic_shuffle" />

</LinearLayout>
