<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/screen_padding_top_game"
        android:paddingBottom="@dimen/screen_padding_bottom_game">

        <include
            android:id="@+id/top_bar"
            layout="@layout/view_game_top_bar" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/game_section_min_gap" />

        <!-- Outcome: circle, country, points and how they add up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/result_circle"
                android:layout_width="@dimen/result_circle_size"
                android:layout_height="@dimen/result_circle_size"
                android:background="@drawable/bg_result_circle"
                android:contentDescription="@string/outcome_correct"
                android:padding="@dimen/result_icon_padding"
                android:src="@drawable/ic_check"
                app:tint="@color/correct" />

            <TextView
                android:id="@+id/result_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_header"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Ondes.Headline.Country" />

            <TextView
                android:id="@+id/result_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_result"
                android:textAppearance="@style/TextAppearance.Ondes.Mono.Points" />

            <TextView
                android:id="@+id/result_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_result"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Ondes.Mono.Muted.Small" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/game_section_min_gap" />

        <!-- The station that was playing -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/station_logo_size"
                        android:layout_height="@dimen/station_logo_size">

                        <TextView
                            android:id="@+id/station_logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_station_logo"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.Ondes.Title"
                            android:textColor="@color/accent" />

                        <!-- The station favicon covers the initials once it loads -->
                        <ImageView
                            android:id="@+id/station_favicon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_station_logo"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/station_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Ondes.Station" />

                        <TextView
                            android:id="@+id/station_place"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_station_lines"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Ondes.Body.Muted" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Wraps to a second row when the tags are long -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/station_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_card_inner"
                    app:chipSpacingHorizontal="@dimen/gap_chip"
                    app:chipSpacingVertical="@dimen/gap_chip" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_thin"
                    android:layout_marginTop="@dimen/gap_card_inner"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_card_inner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <me.sectiontn.ondes.ui.common.EqualizerView
                        android:id="@+id/station_equalizer"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/result_equalizer_height"
                        app:barCount="4" />

                    <TextView
                        android:id="@+id/station_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_row"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Ondes.Status" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/station_play_button"
                        style="@style/Widget.Ondes.IconButton.Accent"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_marginTop="@dimen/icon_button_outset"
                        android:layout_marginEnd="@dimen/icon_button_outset"
                        android:layout_marginBottom="@dimen/icon_button_outset"
                        app:icon="@drawable/ic_pause" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/game_section_min_gap" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_answer"
            android:text="@string/action_save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
