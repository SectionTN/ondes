<?xml version="1.0" encoding="utf-8"?>
<!-- One column of the continent counts on the Passport progress card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
        android:id="@+id/continent_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Ondes.Mono.Count" />

    <TextView
        android:id="@+id/continent_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_text_lines"
        android:textAppearance="@style/TextAppearance.Ondes.Caption.Small" />
</LinearLayout>
