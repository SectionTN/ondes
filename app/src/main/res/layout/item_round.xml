<?xml version="1.0" encoding="utf-8"?>
<!-- One round on Summary: outcome square, country, station or guess, points -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/summary_row_min_height"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/round_square"
        android:layout_width="@dimen/outcome_square_size"
        android:layout_height="@dimen/outcome_square_size"
        android:background="@drawable/bg_outcome_square"
        android:contentDescription="@string/outcome_correct"
        android:padding="@dimen/outcome_icon_padding"
        app:tint="@color/on_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_row"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/round_country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Ondes.Body.Medium" />

        <TextView
            android:id="@+id/round_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_text_lines"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Ondes.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/round_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_row"
        android:textAppearance="@style/TextAppearance.Ondes.Mono" />
</LinearLayout>
